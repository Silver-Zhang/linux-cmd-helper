#!/usr/bin/env bash
set -euo pipefail
umask 077

# shellcheck disable=SC1090
source "$HOME/.local/lib/copilot-cmd-trash.sh"

if ! command -v crontab >/dev/null 2>&1; then
  echo "未找到 crontab，本系统上无法使用定时清理回收站功能。" >&2
  echo "无需关闭。" >&2
  exit 1
fi

if ! cmd_trash_crontab_read; then
  exit 1
fi

case "$(cmd_trash_mark_state)" in
  none)
    echo "回收站定时清理本来就没有开启，无需关闭。"
    exit 0
    ;;
  broken)
    echo "错误：crontab 中的标记块不完整，已中止，未做任何修改。" >&2
    echo "请先执行 crontab -l 检查下面两行是否成对出现，手工修复后重试：" >&2
    echo "  $CMD_TRASH_MARK_BEGIN" >&2
    echo "  $CMD_TRASH_MARK_END" >&2
    exit 1
    ;;
esac

REMAINING="$(cmd_trash_crontab_strip)"

if cmd_trash_crontab_is_empty "$REMAINING"; then
  # 只有确认 crontab 中没有其它内容时才删除整份表；删除失败必须报告，
  # 不能继续输出“已关闭”，否则旧的定时任务可能仍在运行。
  if ! crontab -r; then
    echo "错误：删除空的 crontab 失败，回收站定时清理状态未确认。" >&2
    exit 1
  fi
else
  printf '%s\n' "$REMAINING" | crontab -
fi

echo "已关闭回收站定时清理。"
