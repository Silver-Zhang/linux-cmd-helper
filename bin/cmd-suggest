#!/usr/bin/env bash
set -euo pipefail
umask 077

# shellcheck disable=SC1090
source "$HOME/.local/lib/copilot-cmd-env.sh"
cmd_init_runtime
# shellcheck disable=SC1090
source "$HOME/.local/lib/copilot-cmd-context.sh"

cmd_require_deepseek_key || exit 1

if ! command -v copilot-cmd-send >/dev/null 2>&1; then
  echo "错误：未找到 copilot-cmd-send，请重新安装 cmd-helper。" >&2
  exit 1
fi

export COPILOT_PROVIDER_TYPE='anthropic'
export COPILOT_PROVIDER_BASE_URL='https://api.deepseek.com/anthropic'
export COPILOT_PROVIDER_MAX_PROMPT_TOKENS='840000'
export COPILOT_PROVIDER_MAX_OUTPUT_TOKENS='128000'
export COPILOT_MODEL="${COPILOT_MODEL:-$CMD_DEEPSEEK_FLASH_MODEL}"

BASE="$HOME/.cache/copilot-cmd"
SUG_DIR="$BASE/suggestions"
mkdir -p "$SUG_DIR"

OUT="$SUG_DIR/latest.txt"
PREV="$SUG_DIR/previous.txt"
CTX="$SUG_DIR/context.txt"
SUG_TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$SUG_TMP_DIR"' EXIT

# Suggestions should use the same compact, opt-in context policy as cmd/cmdx.
# Do not implicitly generate and send the full cmd-context snapshot.
{
  append_compact_context
} > "$CTX"

MAX_PREVIOUS_LINES="${CMD_SUGGEST_PREVIOUS_LINES:-40}"
case "$MAX_PREVIOUS_LINES" in
  ''|*[!0-9]*) MAX_PREVIOUS_LINES=40 ;;
esac


generate_suggestions() {
  local prompt_file
  prompt_file="$SUG_TMP_DIR/prompt.txt"

  {
    cat <<'HEADER'
你是一个 Linux 终端排错问题推荐器。

请根据下面的上下文，推荐 5 个用户最可能应该继续问 AI 的问题。

严格输出格式：
[1] 问题一
[2] 问题二
[3] 问题三
[4] 问题四
[5] 问题五

要求：
1. 不要输出 Markdown。
2. 不要解释。
3. 不要输出额外内容。
4. 问题要具体、可操作，适合继续发送给 Linux 命令行排错助手。
5. 优先围绕最近 cmd-run / cmd-record / 当前目录 / Git 状态 / 报错日志推荐。
6. 如果上下文中没有明显错误，也要推荐“下一步可以检查什么”的问题。

HEADER

    if [ -s "$PREV" ]; then
      echo "下面是上一批已经推荐过的问题，请尽量不要重复："
      echo
      cat "$PREV"
      echo
    fi

    echo "上下文如下："
    echo
    cat "$CTX"
  } > "$prompt_file"

  echo "" >&2
  echo "[cmd-suggest] backend: DeepSeek BYOK" >&2
  echo "[cmd-suggest] model:   ${COPILOT_MODEL:-unknown}" >&2
  echo "" >&2

  # 生成问题。这里禁止 shell/write 工具，cmd-suggest 只需要纯文本推荐。
  # 先写临时文件，避免第一次失败时覆盖上一批可用结果。
  CANDIDATE="$SUG_DIR/.latest.$$"
  if copilot-cmd-send --prompt-file "$prompt_file" -- \
      --deny-tool='shell(*)' \
      --deny-tool='write' > "$CANDIDATE" 2>&1; then
    :
  else
    FIRST_RC=$?
    echo "" >&2
    echo "[cmd-suggest] first attempt failed (exit $FIRST_RC); retrying with --deny-tool=shell" >&2
    if copilot-cmd-send --prompt-file "$prompt_file" -- \
        --deny-tool='shell' \
        --deny-tool='write' > "$CANDIDATE" 2>&1; then
      :
    else
      SECOND_RC=$?
      rm -f "$CANDIDATE"
      echo "[cmd-suggest] model call failed (exit $SECOND_RC); previous suggestions were kept." >&2
      return "$SECOND_RC"
    fi
  fi

  if [ ! -s "$CANDIDATE" ]; then
    echo "[cmd-suggest] model returned no suggestions; previous suggestions were kept." >&2
    rm -f "$CANDIDATE"
    return 1
  fi

  # Keep only the latest bounded batch. This avoids an unbounded prompt and
  # prevents previous.txt from growing forever during repeated `r` actions.
  awk '/^\[[1-5]\][[:space:]]+[^[:space:]].*/ { print; count++; if (count == 5) exit }' \
    "$CANDIDATE" > "$OUT.tmp"
  if [ "$(wc -l < "$OUT.tmp" | tr -d ' ')" -ne 5 ]; then
    echo "[cmd-suggest] model returned an invalid suggestion list; previous suggestions were kept." >&2
    rm -f "$CANDIDATE" "$OUT.tmp"
    return 1
  fi
  mv "$OUT.tmp" "$OUT"
  rm -f "$CANDIDATE"
  cp "$OUT" "$PREV.tmp"
  tail -n "$MAX_PREVIOUS_LINES" "$PREV.tmp" > "$PREV"
  rm -f "$PREV.tmp"
}

while true; do
  generate_suggestions

  echo
  echo "操作："
  echo "  1-5  发送对应问题到当前 cmd session"
  echo "  r    换一批问题"
  echo "  q    退出"
  echo "  回车 退出"
  echo

  read -r -p "请选择: " ans || {
    echo "" >&2
    echo "已取消（未收到输入）。" >&2
    exit 0
  }

  case "$ans" in
    "")
      exit 0
      ;;
    q|Q|quit|exit)
      exit 0
      ;;
    r|R|n|N|next|换|换一批)
      echo
      echo "正在生成另一批问题..."
      echo
      continue
      ;;
    1|2|3|4|5)
      QUESTION="$(awk -v n="$ans" '$0 ~ "^\\[" n "\\][[:space:]]+" { sub("^\\[" n "\\][[:space:]]+", ""); print; exit }' "$OUT")"
      if [ -z "$QUESTION" ]; then
        echo "No question found for [$ans]." >&2
        exit 1
      fi

      echo
      echo "Sending to cmd session:"
      echo "$QUESTION"
      echo

      exec cmd "$QUESTION"
      ;;
    *)
      echo "无效输入：$ans" >&2
      echo "请输入 1-5、r、q，或直接回车退出。" >&2
      ;;
  esac
done
