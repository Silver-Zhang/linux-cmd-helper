#!/usr/bin/env bash
set -euo pipefail

PROMPT_FILE=""
ARGS=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --prompt-file)
      PROMPT_FILE="$2"
      shift 2
      ;;
    --)
      shift
      while [ "$#" -gt 0 ]; do
        ARGS+=("$1")
        shift
      done
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

if [ -z "$PROMPT_FILE" ]; then
  echo "Usage: copilot-cmd-send --prompt-file <file> -- [extra copilot args]" >&2
  exit 1
fi

if [ ! -f "$PROMPT_FILE" ]; then
  echo "Prompt file not found: $PROMPT_FILE" >&2
  exit 1
fi

PROMPT="$(cat "$PROMPT_FILE")"

# 优先继续 cmd 专用 session；没有 session 时创建新 session。
if copilot --continue -p "$PROMPT" "${ARGS[@]}"; then
  exit 0
fi

copilot -p "$PROMPT" "${ARGS[@]}"
