#!/usr/bin/env bash
set -euo pipefail
umask 077

PROMPT_FILE=""
ARGS=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --prompt-file)
      if [ "$#" -lt 2 ]; then
        echo "Missing value after --prompt-file" >&2
        exit 1
      fi
      PROMPT_FILE="$2"
      shift 2
      ;;
    --)
      shift
      while [ "$#" -gt 0 ]; do
        ARGS+=("$1")
        shift
      done
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

if [ -z "$PROMPT_FILE" ]; then
  echo "Usage: copilot-cmd-send --prompt-file <file> -- [extra copilot args]" >&2
  exit 1
fi

if [ ! -f "$PROMPT_FILE" ]; then
  echo "Prompt file not found: $PROMPT_FILE" >&2
  exit 1
fi

if ! command -v copilot >/dev/null 2>&1; then
  echo "错误：未找到 copilot 命令，请先安装 GitHub Copilot CLI。" >&2
  exit 1
fi

PROMPT="$(cat "$PROMPT_FILE")"
FIRST_OUTPUT="$(mktemp)"
trap 'rm -f "$FIRST_OUTPUT"' EXIT

# 优先继续 cmd 专用 session。只有明确像「没有可继续的 session」时才创建新 session；
# 认证、网络、参数和服务端错误不能被当成 no-session 重试，否则可能重复请求/收费。
if copilot --continue -p "$PROMPT" "${ARGS[@]}" >"$FIRST_OUTPUT" 2>&1; then
  cat "$FIRST_OUTPUT"
  exit 0
else
  FIRST_RC=$?
fi

if grep -Eiq 'no (active )?(session|conversation)|no session to continue|cannot continue|nothing to continue|session.*not found|conversation.*not found' "$FIRST_OUTPUT"; then
  copilot -p "$PROMPT" "${ARGS[@]}"
  exit $?
fi

cat "$FIRST_OUTPUT" >&2
exit "$FIRST_RC"
