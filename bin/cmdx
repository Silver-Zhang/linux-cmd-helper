#!/usr/bin/env bash
set -euo pipefail

# shellcheck disable=SC1090
source "$HOME/.local/lib/copilot-cmd-platform.sh"
# shellcheck disable=SC1090
source "$HOME/.local/lib/copilot-cmd-env.sh"
# shellcheck disable=SC1090
source "$HOME/.local/lib/copilot-cmd-context.sh"
# shellcheck disable=SC1090
source "$HOME/.local/lib/copilot-cmd-ui.sh"

usage() {
  cat <<'USAGE'
用法：
  cmdx [上下文选项] [模型选项] "问题"
  cmdx [上下文选项] [模型选项] -
  cmdx [上下文选项] [模型选项] -f <file>
  cmdx [上下文选项] [模型选项] -e

  cmdx --loop "问题"
  cmdx -L "问题"
  cmdx --loop --max-rounds 10 "问题"

上下文选项（默认最小上下文，省 token）：
  -c, --context       发送精简上下文（pwd/git/disk/meta）
  --last-run[=N]      精简上下文 + last-run 日志尾部（默认 200 行，可指定行数）
  --last-record[=N]   精简上下文 + last-record 日志尾部（默认 300 行，可指定行数）
  --full-context      发送完整上下文（调用 cmd-context，含目录列表、bash 历史等）

Loop 模式：
  -L, --loop          多轮审批模式：AI 分析→申请命令→用户审批→执行→AI 再分析
  --max-rounds N      最大轮数（默认 5）

说明：
  cmdx 允许 AI 提出需要运行的 shell 命令。
  命令不会自动执行，必须由用户输入 yes 确认。
  执行结果会保存到 ~/.cache/copilot-cmd/approved-runs/ 下。

  默认 cmdx 是单轮审批。cmdx --loop 是多轮审批式诊断，每一轮仍需用户确认。

后端：
  默认：DeepSeek Flash
  -m pro：DeepSeek Pro
  --copilot：GitHub Copilot native 当前/default 模型
  --copilot -m <ID>：GitHub Copilot native 显式模型 ID

注意：
  Copilot /model 菜单里的显示名不一定能作为 --model 参数使用。
  推荐用 cmd-model 选择 Copilot native 模型，然后用 cmdx --copilot。
USAGE
}

BASE="$HOME/.cache/copilot-cmd"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

USER_INPUT="$TMP_DIR/user_input.txt"
PROMPT_FILE="$TMP_DIR/prompt.txt"
RESPONSE_FILE="$TMP_DIR/ai_response.txt"
CMD_FILE="$TMP_DIR/proposed_commands.sh"

BACKEND="deepseek"
MODEL="flash"
COPILOT_EXTRA_ARGS=()
CTX_MODE="minimal"
INCLUDE_LAST_RUN=0
INCLUDE_LAST_RECORD=0
FULL_CONTEXT=0
LOOP_MODE=0
MAX_ROUNDS=5
ARGS=()

# -----------------------------
# 0. 解析参数
# -----------------------------
while [ "$#" -gt 0 ]; do
  case "$1" in
    -c|--context)
      CTX_MODE="compact"
      shift
      ;;
    --last-run)
      CTX_MODE="compact"
      INCLUDE_LAST_RUN=1
      shift
      ;;
    --last-run=*)
      CTX_MODE="compact"
      INCLUDE_LAST_RUN=1
      CMD_LAST_RUN_TAIL="${1#--last-run=}"
      shift
      ;;
    --last-record)
      CTX_MODE="compact"
      INCLUDE_LAST_RECORD=1
      shift
      ;;
    --last-record=*)
      CTX_MODE="compact"
      INCLUDE_LAST_RECORD=1
      CMD_LAST_RECORD_TAIL="${1#--last-record=}"
      shift
      ;;
    --full-context)
      CTX_MODE="full"
      FULL_CONTEXT=1
      shift
      ;;
    --deepseek|--ds)
      BACKEND="deepseek"
      shift
      ;;
    -L|--loop)
      LOOP_MODE=1
      shift
      ;;
    --max-rounds)
      if [ "$#" -lt 2 ]; then
        echo "Error: missing value after $1" >&2
        exit 1
      fi
      if ! [[ "$2" =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: --max-rounds requires a positive integer, got: $2" >&2
        exit 1
      fi
      MAX_ROUNDS="$2"
      shift 2
      ;;
    --max-rounds=*)
      MAX_ROUNDS="${1#--max-rounds=}"
      if ! [[ "$MAX_ROUNDS" =~ ^[1-9][0-9]*$ ]]; then
        echo "Error: --max-rounds requires a positive integer, got: $MAX_ROUNDS" >&2
        exit 1
      fi
      shift
      ;;
    --copilot|--github|--native|--gh)
      BACKEND="copilot"
      MODEL=""
      shift
      ;;
    -m|--model)
      if [ "$#" -lt 2 ]; then
        echo "Error: missing model after $1" >&2
        exit 1
      fi
      MODEL="$2"
      shift 2
      ;;
    --model=*)
      MODEL="${1#--model=}"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      while [ "$#" -gt 0 ]; do
        ARGS+=("$1")
        shift
      done
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

set -- "${ARGS[@]}"

# -----------------------------
# 0.1 设置模型后端
# -----------------------------
if [ "$BACKEND" = "deepseek" ]; then
  export COPILOT_PROVIDER_TYPE='anthropic'
  export COPILOT_PROVIDER_BASE_URL='https://api.deepseek.com/anthropic'
  export COPILOT_PROVIDER_MAX_PROMPT_TOKENS='840000'
  export COPILOT_PROVIDER_MAX_OUTPUT_TOKENS='128000'

  if [ -z "${COPILOT_PROVIDER_API_KEY:-}" ]; then
    echo "Error: COPILOT_PROVIDER_API_KEY is empty. Check ~/.config/copilot-deepseek/env" >&2
    exit 1
  fi

  case "$MODEL" in
    ""|flash)
      export COPILOT_MODEL='deepseek-v4-flash'
      ;;
    pro)
      export COPILOT_MODEL='deepseek-v4-pro'
      ;;
    *)
      export COPILOT_MODEL="$MODEL"
      ;;
  esac

elif [ "$BACKEND" = "copilot" ]; then
  # 使用 GitHub Copilot native 后端时，必须取消 DeepSeek BYOK 变量
  unset COPILOT_PROVIDER_TYPE
  unset COPILOT_PROVIDER_BASE_URL
  unset COPILOT_PROVIDER_API_KEY
  unset COPILOT_PROVIDER_MAX_PROMPT_TOKENS
  unset COPILOT_PROVIDER_MAX_OUTPUT_TOKENS
  unset COPILOT_MODEL

  # 默认不传 --model，使用 Copilot CLI 当前/default 模型。
  # 如果用户显式 -m，则认为用户知道真正可用的内部模型 ID。
  if [ -n "${MODEL:-}" ]; then
    COPILOT_EXTRA_ARGS+=(--model "$MODEL")
  fi

else
  echo "Error: unknown backend: $BACKEND" >&2
  exit 1
fi

# -----------------------------
# 1. 读取用户问题
# -----------------------------
if [ "$#" -eq 0 ]; then
  if [ -t 0 ]; then
    usage
    exit 0
  else
    cat > "$USER_INPUT"
  fi
else
  case "$1" in
    -|--stdin)
      cat > "$USER_INPUT"
      ;;
    -f|--file)
      if [ "$#" -lt 2 ]; then
        echo "Error: missing file path after $1" >&2
        exit 1
      fi
      if [ ! -f "$2" ]; then
        echo "Error: file not found: $2" >&2
        exit 1
      fi
      cat "$2" > "$USER_INPUT"
      ;;
    -e|--edit|--editor)
      EDITOR_CMD="${EDITOR:-nano}"
      "$EDITOR_CMD" "$USER_INPUT"
      ;;
    *)
      printf '%s\n' "$*" > "$USER_INPUT"
      ;;
  esac
fi

if [ ! -s "$USER_INPUT" ]; then
  echo "Error: empty question." >&2
  exit 1
fi

# 保存问题，便于回看
QUESTION_TS="$(date '+%Y%m%d-%H%M%S')"
QUESTION_DIR="$BASE/questions/$QUESTION_TS-cmdx"
mkdir -p "$QUESTION_DIR"
cp "$USER_INPUT" "$QUESTION_DIR/question.txt"
ln -sfn "$QUESTION_DIR" "$BASE/last-question"

ui_info "cmdx" "question saved: $QUESTION_DIR/question.txt"
ui_question_preview "$USER_INPUT" "${CMD_QUESTION_PREVIEW_LINES:-80}"

# 防止过长输入
MAX_BYTES=120000
INPUT_BYTES="$(wc -c < "$USER_INPUT" | tr -d ' ')"
if [ "$INPUT_BYTES" -gt "$MAX_BYTES" ]; then
  TRIMMED="$TMP_DIR/user_input_trimmed.txt"
  head -c "$MAX_BYTES" "$USER_INPUT" > "$TRIMMED"
  {
    echo
    echo "[NOTE] 用户输入原始长度为 ${INPUT_BYTES} bytes，已截断为前 ${MAX_BYTES} bytes。"
    echo "如需完整分析，请把日志保存为文件，并使用 cmd-run 或 cmd-record 方式保留上下文。"
  } >> "$TRIMMED"
  mv "$TRIMMED" "$USER_INPUT"
fi

# -----------------------------
# 2. 构造第一轮 prompt
# -----------------------------
{
  if [ "$CTX_MODE" = "full" ]; then
    cat <<'HEADER'
你是一个谨慎的 Linux 终端命令行助手，运行环境是 Ubuntu 多用户科研服务器。

你可以做两类回答：

A. 如果不需要运行命令就能回答：
直接给出答案，不要输出命令执行标记。

B. 如果必须运行命令才能判断：
请先简短说明为什么需要运行命令，然后只在下面两个标记之间输出建议执行的 Bash 命令：

__CMDX_BEGIN__
命令1
命令2
__CMDX_END__

严格规则：
1. 优先提出只读检查命令。
2. 不要默认使用 sudo。
3. 不要默认访问其他用户目录。
4. 不要提出破坏性命令，例如 rm -rf、mkfs、dd、chmod -R、chown -R、iptables、ufw、docker 删除等。
5. 如果确实需要高风险命令，只能解释原因，不要放进 __CMDX_BEGIN__。
6. 命令应尽量短小、可审计。
7. 不要用反引号包裹命令，不要输出 Markdown 代码块。
8. 只能在 __CMDX_BEGIN__ 和 __CMDX_END__ 之间放真正要执行的命令。

下面是当前上下文：

HEADER
  else
    cat <<'HEADER'
你是 Linux 终端命令行助手。默认给只读检查命令；不要默认 sudo；不要访问其他用户目录；高风险操作必须提示风险；cmdx 只能在用户确认后执行命令。

如果不需要运行命令就能回答，直接给出答案。
如果必须运行命令，在下面两个标记之间输出建议执行的 Bash 命令：

__CMDX_BEGIN__
命令
__CMDX_END__

不要用反引号或 Markdown 代码块包裹命令。只在标记之间放真正要执行的命令。

HEADER
  fi

  # Context body based on mode
  case "$CTX_MODE" in
    minimal)
      append_minimal_context "$BACKEND" "${COPILOT_MODEL:-${MODEL:-}}"
      ;;
    compact)
      append_compact_context
      if [ "$INCLUDE_LAST_RUN" -eq 1 ]; then
        append_last_run_tail
      fi
      if [ "$INCLUDE_LAST_RECORD" -eq 1 ]; then
        append_last_record_tail
      fi
      ;;
    full)
      CTX_FILE="$(cmd-context)"
      cat "$CTX_FILE"

      echo
      echo "## Latest cmd-run"
      if [ -L "$BASE/last-run" ] || [ -d "$BASE/last-run" ]; then
        RUN_DIR="$(resolve_path "$BASE/last-run" 2>/dev/null || true)"
        echo "last-run: ${RUN_DIR:-none}"
        if [ -n "${RUN_DIR:-}" ] && [ -f "$RUN_DIR/meta.txt" ]; then
          echo '```text'
          cat "$RUN_DIR/meta.txt" 2>/dev/null || true
          echo '```'
        fi
        if [ -n "${RUN_DIR:-}" ] && [ -f "$RUN_DIR/output.log" ]; then
          echo '```text'
          tail -n "$CMD_LAST_RUN_TAIL" "$RUN_DIR/output.log" 2>/dev/null || true
          echo '```'
        fi
      else
        echo "last-run: none"
      fi

      echo
      echo "## Latest cmd-record"
      if [ -L "$BASE/last-record" ] || [ -d "$BASE/last-record" ]; then
        REC_DIR="$(resolve_path "$BASE/last-record" 2>/dev/null || true)"
        echo "last-record: ${REC_DIR:-none}"
        if [ -n "${REC_DIR:-}" ] && [ -f "$REC_DIR/meta.txt" ]; then
          echo '```text'
          cat "$REC_DIR/meta.txt" 2>/dev/null || true
          echo '```'
        fi
        if [ -n "${REC_DIR:-}" ] && [ -f "$REC_DIR/output.log" ]; then
          echo '```text'
          tail -n "$CMD_LAST_RECORD_TAIL" "$REC_DIR/output.log" 2>/dev/null || true
          echo '```'
        fi
      else
        echo "last-record: none"
      fi
      ;;
  esac

  echo
  append_model_info "$BACKEND" "${MODEL:-}" "${COPILOT_MODEL:-}"

  echo
  echo "## User question"
  echo '```text'
  cat "$USER_INPUT"
  echo '```'
} > "$PROMPT_FILE"

# -----------------------------
# 3. 显示后端和模型
# -----------------------------
_CMDX_BACKEND_DISPLAY=""
_CMDX_MODEL_DISPLAY=""

if [ "$BACKEND" = "deepseek" ]; then
  _CMDX_BACKEND_DISPLAY="DeepSeek BYOK"
  _CMDX_MODEL_DISPLAY="${COPILOT_MODEL:-unknown}"
else
  _CMDX_BACKEND_DISPLAY="GitHub Copilot native"
  if [ -n "${MODEL:-}" ]; then
    _CMDX_MODEL_DISPLAY="${MODEL} (--model)"
  else
    NATIVE_MODEL_FILE="$HOME/.config/copilot-cmd/current-native-model"
    if [ -f "$NATIVE_MODEL_FILE" ] && [ -s "$NATIVE_MODEL_FILE" ]; then
      _CMDX_MODEL_DISPLAY="$(cat "$NATIVE_MODEL_FILE")"
    else
      _CMDX_MODEL_DISPLAY="Copilot CLI current/default"
    fi
  fi
fi

if [ "$LOOP_MODE" -eq 1 ]; then
  ui_model_info "cmdx loop" "$_CMDX_BACKEND_DISPLAY" "$_CMDX_MODEL_DISPLAY" "$CTX_MODE" "mode" "multi-round approval" "max rounds" "$MAX_ROUNDS"
else
  ui_model_info "cmdx" "$_CMDX_BACKEND_DISPLAY" "$_CMDX_MODEL_DISPLAY" "$CTX_MODE" "mode" "single-round approval"
fi

# =============================================================================
# LOOP MODE vs SINGLE-ROUND MODE
# =============================================================================

if [ "$LOOP_MODE" -eq 1 ]; then
  # -----------------------------------------------------------
  # LOOP MODE: multi-round user-approved command execution
  # -----------------------------------------------------------

  LOOP_TS="$(date '+%Y%m%d-%H%M%S')"
  LOOP_DIR="$BASE/approved-runs/${LOOP_TS}-loop"
  mkdir -p "$LOOP_DIR"
  {
    echo "loop_start: $(date '+%F %T %Z')"
    echo "max_rounds: $MAX_ROUNDS"
    echo "cwd: $(pwd)"
    echo "user: $(whoami)"
    echo "host: $(hostname)"
    echo "backend: $BACKEND"
    if [ "$BACKEND" = "deepseek" ]; then
      echo "model: ${COPILOT_MODEL:-unknown}"
    else
      if [ -n "${MODEL:-}" ]; then
        echo "model: ${MODEL} (--model)"
      else
        echo "model: GitHub Copilot CLI current/default model"
      fi
    fi
  } > "$LOOP_DIR/loop-meta.txt"

  # Build initial loop prompt with loop-specific system instructions
  LOOP_PROMPT="$TMP_DIR/loop_prompt.txt"
  {
    cat <<'LOOP_SYSTEM'
你是一个谨慎的 Linux 终端命令行助手，运行环境是 Ubuntu 多用户科研服务器。
当前处于多轮诊断模式。每一轮你只能提出"当前下一步最必要"的命令。

严格规则：
1. 每一轮只提出当前下一步最必要的命令，不要提前列出多个条件分支的未来命令。
2. 不要一次性打包整个诊断计划。
3. 看到执行结果后，再决定是否提出下一轮命令。
4. 优先提出只读检查命令。
5. 不要默认使用 sudo。
6. 不要默认访问其他用户目录。
7. 高风险命令（如 sudo, rm -rf, mkfs, dd, chmod -R, chown -R, iptables, ufw, docker 删除, shutdown, reboot, systemctl stop/restart/disable）不要放入 __CMDX_BEGIN__，只能说明风险和原因。
8. 如果已经足够判断问题，应直接给最终结论，不要再申请命令。

如果不需要运行命令就能回答，直接给出答案，不要输出命令执行标记。
如果必须运行命令，在下面两个标记之间输出建议执行的 Bash 命令：

__CMDX_BEGIN__
命令
__CMDX_END__

不要用反引号或 Markdown 代码块包裹命令。只在标记之间放真正要执行的命令。

LOOP_SYSTEM

    # Context
    case "$CTX_MODE" in
      minimal)
        append_minimal_context "$BACKEND" "${COPILOT_MODEL:-${MODEL:-}}"
        ;;
      compact)
        append_compact_context
        if [ "$INCLUDE_LAST_RUN" -eq 1 ]; then
          append_last_run_tail
        fi
        if [ "$INCLUDE_LAST_RECORD" -eq 1 ]; then
          append_last_record_tail
        fi
        ;;
      full)
        CTX_FILE="$(cmd-context)"
        cat "$CTX_FILE"
        ;;
    esac

    echo
    append_model_info "$BACKEND" "${MODEL:-}" "${COPILOT_MODEL:-}"

    echo
    echo "## User question"
    echo '```text'
    cat "$USER_INPUT"
    echo '```'
  } > "$LOOP_PROMPT"

  CURRENT_PROMPT="$LOOP_PROMPT"
  LAST_RC=0

  for (( ROUND=1; ROUND<=MAX_ROUNDS; ROUND++ )); do
    ui_round_header "$ROUND" "$MAX_ROUNDS"

    ROUND_RESPONSE="$TMP_DIR/loop_response_${ROUND}.txt"
    ROUND_CMD="$TMP_DIR/loop_commands_${ROUND}.sh"

    # Send prompt to AI
    ui_spinner_start "Waiting for model response..."
    if ! copilot-cmd-send --prompt-file "$CURRENT_PROMPT" -- \
        "${COPILOT_EXTRA_ARGS[@]}" \
        --deny-tool='shell(*)' \
        --deny-tool='write' > "$ROUND_RESPONSE" 2>&1; then
      copilot-cmd-send --prompt-file "$CURRENT_PROMPT" -- \
        "${COPILOT_EXTRA_ARGS[@]}" \
        --deny-tool='shell' \
        --deny-tool='write' > "$ROUND_RESPONSE" 2>&1
    fi
    ui_spinner_stop

    ui_ai_begin
    cat "$ROUND_RESPONSE"
    ui_ai_end

    # Extract commands
    awk '
      /^__CMDX_BEGIN__$/ {flag=1; next}
      /^__CMDX_END__$/ {flag=0; next}
      flag {print}
    ' "$ROUND_RESPONSE" > "$ROUND_CMD"

    # Check if AI proposed commands
    if ! grep -v '^[[:space:]]*$' "$ROUND_CMD" | grep -v '^[[:space:]]*#' >/dev/null 2>&1; then
      ui_info "cmdx" "no further command request; loop finished."
      break
    fi

    # Display proposed commands
    ui_cmd_block "$ROUND_CMD"

    # User approval
    if grep -Eiq '(^|[;&|[:space:]])sudo([[:space:]]|$)|rm[[:space:]]+-rf|mkfs|dd[[:space:]]+if=|chmod[[:space:]]+-R|chown[[:space:]]+-R|iptables|ufw|docker[[:space:]]+(rm|rmi|system[[:space:]]+prune)|shutdown|reboot|systemctl[[:space:]]+(stop|restart|disable)' "$ROUND_CMD"; then
      echo "[cmdx] WARNING: 检测到潜在高风险命令。"
      echo "[cmdx] 如确需执行，必须输入 YES I UNDERSTAND。"
      read -r -p "确认执行？ " ans
      if [ "$ans" != "YES I UNDERSTAND" ]; then
        echo "[cmdx] 已取消执行。loop 结束。"
        break
      fi
    else
      read -r -p "是否执行？输入 yes 才执行；输入 edit 可先编辑；其他输入取消: " ans
      case "$ans" in
        yes)
          ;;
        edit)
          EDITOR_CMD="${EDITOR:-nano}"
          "$EDITOR_CMD" "$ROUND_CMD"
          echo
          echo "[cmdx] 编辑后的命令："
          nl -ba "$ROUND_CMD"
          echo
          read -r -p "确认执行编辑后的命令？输入 yes 才执行: " ans2
          if [ "$ans2" != "yes" ]; then
            echo "[cmdx] 已取消执行。loop 结束。"
            break
          fi
          ;;
        *)
          echo "[cmdx] 已取消执行。loop 结束。"
          break
          ;;
      esac
    fi

    # Execute commands and save to round directory
    ROUND_DIR="$LOOP_DIR/$(printf 'round-%02d' "$ROUND")"
    mkdir -p "$ROUND_DIR"

    cp "$ROUND_CMD" "$ROUND_DIR/commands.sh"
    chmod 700 "$ROUND_DIR/commands.sh"

    {
      echo "round: $ROUND"
      echo "time_start: $(date '+%F %T %Z')"
      echo "cwd: $(pwd)"
      echo "user: $(whoami)"
      echo "host: $(hostname)"
      echo "backend: $BACKEND"
      if [ "$BACKEND" = "deepseek" ]; then
        echo "model: ${COPILOT_MODEL:-unknown}"
      else
        if [ -n "${MODEL:-}" ]; then
          echo "model: ${MODEL} (--model)"
        else
          echo "model: GitHub Copilot CLI current/default model"
        fi
      fi
    } > "$ROUND_DIR/meta.txt"

    echo
    ui_info "cmdx" "executing commands..."
    ui_info "cmdx" "log: $ROUND_DIR/output.log"
    ui_exec_begin

    set +e
    bash "$ROUND_DIR/commands.sh" 2>&1 | tee "$ROUND_DIR/output.log"
    LAST_RC=${PIPESTATUS[0]}
    set -e

    ui_exec_end

    {
      echo "time_end: $(date '+%F %T %Z')"
      echo "exit_code: $LAST_RC"
    } >> "$ROUND_DIR/meta.txt"

    ui_info "cmdx" "round $ROUND exit_code=$LAST_RC"
    ui_info "cmdx" "saved: $ROUND_DIR"

    ln -sfn "$LOOP_DIR" "$BASE/last-approved-run"

    # If we've reached max rounds, stop
    if [ "$ROUND" -eq "$MAX_ROUNDS" ]; then
      ui_info "cmdx" "reached max rounds; stop."
      ui_info "cmdx" "you can re-run cmdx --loop to continue."
      break
    fi

    # Build follow-up prompt for next round
    CURRENT_PROMPT="$TMP_DIR/loop_followup_${ROUND}.txt"
    {
      cat <<'FOLLOWUP_HEADER'
你是一个谨慎的 Linux 终端命令行助手，当前处于多轮诊断模式。

用户批准并执行了你建议的命令。请根据执行结果继续分析：
1. 先判断命令是否成功；
2. 如果失败，指出关键错误；
3. 判断是否已经能得出结论；
4. 如果已经足够判断问题，直接给最终结论，不要再申请命令；
5. 如果还需要下一步检查，提出当前下一步最必要的命令。

严格规则：
- 每一轮只提出当前下一步最必要的命令。
- 不要提前列出多个条件分支的未来命令。
- 不要一次性打包整个诊断计划。
- 优先提出只读检查命令。
- 不要默认使用 sudo。
- 不要默认访问其他用户目录。
- 高风险命令不要放入 __CMDX_BEGIN__，只能说明风险和原因。

如果不需要再运行命令，直接给出最终结论。
如果必须运行命令，在下面两个标记之间输出建议执行的 Bash 命令：

__CMDX_BEGIN__
命令
__CMDX_END__

不要用反引号或 Markdown 代码块包裹命令。只在标记之间放真正要执行的命令。

FOLLOWUP_HEADER

      echo "## Original user question"
      echo '```text'
      cat "$USER_INPUT"
      echo '```'

      echo
      echo "## Executed commands (round $ROUND)"
      echo '```bash'
      cat "$ROUND_DIR/commands.sh"
      echo '```'

      echo
      echo "## Execution meta"
      echo '```text'
      cat "$ROUND_DIR/meta.txt"
      echo '```'

      echo
      echo "## Execution output"
      echo '```text'
      tail -500 "$ROUND_DIR/output.log"
      echo '```'
    } > "$CURRENT_PROMPT"
  done

  exit "$LAST_RC"
fi

# =============================================================================
# SINGLE-ROUND MODE (default)
# =============================================================================

# -----------------------------
# 4. 第一轮：让 AI 判断是否需要命令
# -----------------------------
ui_spinner_start "Waiting for model response..."
if ! copilot-cmd-send --prompt-file "$PROMPT_FILE" -- \
    "${COPILOT_EXTRA_ARGS[@]}" \
    --deny-tool='shell(*)' \
    --deny-tool='write' > "$RESPONSE_FILE" 2>&1; then
  copilot-cmd-send --prompt-file "$PROMPT_FILE" -- \
    "${COPILOT_EXTRA_ARGS[@]}" \
    --deny-tool='shell' \
    --deny-tool='write' > "$RESPONSE_FILE" 2>&1
fi
ui_spinner_stop

ui_ai_begin
cat "$RESPONSE_FILE"
ui_ai_end

awk '
  /^__CMDX_BEGIN__$/ {flag=1; next}
  /^__CMDX_END__$/ {flag=0; next}
  flag {print}
' "$RESPONSE_FILE" > "$CMD_FILE"

# 去掉空行和纯注释后判断是否有命令
if ! grep -v '^[[:space:]]*$' "$CMD_FILE" | grep -v '^[[:space:]]*#' >/dev/null 2>&1; then
  exit 0
fi

ui_cmd_block "$CMD_FILE"

# -----------------------------
# 5. 用户审批
# -----------------------------
if grep -Eiq '(^|[;&|[:space:]])sudo([[:space:]]|$)|rm[[:space:]]+-rf|mkfs|dd[[:space:]]+if=|chmod[[:space:]]+-R|chown[[:space:]]+-R|iptables|ufw|docker[[:space:]]+(rm|rmi|system[[:space:]]+prune)|shutdown|reboot|systemctl[[:space:]]+(stop|restart|disable)' "$CMD_FILE"; then
  ui_warn "检测到潜在高风险命令。"
  echo "[cmdx] 如确需执行，必须输入 YES I UNDERSTAND。"
  read -r -p "确认执行？ " ans
  if [ "$ans" != "YES I UNDERSTAND" ]; then
    echo "[cmdx] 已取消执行。"
    exit 0
  fi
else
  read -r -p "是否执行？输入 yes 才执行；输入 edit 可先编辑；其他输入取消: " ans
  case "$ans" in
    yes)
      ;;
    edit)
      EDITOR_CMD="${EDITOR:-nano}"
      "$EDITOR_CMD" "$CMD_FILE"
      echo
      echo "[cmdx] 编辑后的命令："
      nl -ba "$CMD_FILE"
      echo
      read -r -p "确认执行编辑后的命令？输入 yes 才执行: " ans2
      if [ "$ans2" != "yes" ]; then
        echo "[cmdx] 已取消执行。"
        exit 0
      fi
      ;;
    *)
      echo "[cmdx] 已取消执行。"
      exit 0
      ;;
  esac
fi

# -----------------------------
# 6. 执行批准命令并记录
# -----------------------------
TS="$(date '+%Y%m%d-%H%M%S')"
RUN_DIR="$BASE/approved-runs/$TS"
mkdir -p "$RUN_DIR"

cp "$CMD_FILE" "$RUN_DIR/commands.sh"
chmod 700 "$RUN_DIR/commands.sh"

{
  echo "time_start: $(date '+%F %T %Z')"
  echo "cwd: $(pwd)"
  echo "user: $(whoami)"
  echo "host: $(hostname)"
  echo "backend: $BACKEND"
  if [ "$BACKEND" = "deepseek" ]; then
    echo "model: ${COPILOT_MODEL:-unknown}"
  else
    if [ -n "${MODEL:-}" ]; then
      echo "model: ${MODEL} (--model)"
    else
      NATIVE_MODEL_FILE="$HOME/.config/copilot-cmd/current-native-model"
      if [ -f "$NATIVE_MODEL_FILE" ] && [ -s "$NATIVE_MODEL_FILE" ]; then
        echo "model: $(cat "$NATIVE_MODEL_FILE")"
        echo "note: display label recorded by cmd-model; actual model is controlled by Copilot CLI /model"
      else
        echo "model: GitHub Copilot CLI current/default model"
      fi
    fi
  fi
} > "$RUN_DIR/meta.txt"

ui_info "cmdx" "executing commands..."
ui_info "cmdx" "log: $RUN_DIR/output.log"
ui_exec_begin

set +e
bash "$RUN_DIR/commands.sh" 2>&1 | tee "$RUN_DIR/output.log"
RC=${PIPESTATUS[0]}
set -e

ui_exec_end

{
  echo "time_end: $(date '+%F %T %Z')"
  echo "exit_code: $RC"
} >> "$RUN_DIR/meta.txt"

ln -sfn "$RUN_DIR" "$BASE/last-approved-run"

ui_info "cmdx" "exit_code=$RC"
ui_info "cmdx" "saved: $RUN_DIR"

echo
read -r -p "是否把执行输出发回 AI 继续分析？直接回车默认 yes，输入 no 跳过: " follow
if [ "${follow:-yes}" = "no" ] || [ "${follow:-yes}" = "n" ]; then
  exit "$RC"
fi

# -----------------------------
# 7. 第二轮：把执行结果发回 AI
# -----------------------------
FOLLOW_PROMPT="$TMP_DIR/followup_prompt.txt"

{
  cat <<'HEADER'
你是一个谨慎的 Linux 终端命令行助手。

用户批准并执行了你建议的命令。请根据执行结果继续分析：
1. 先判断命令是否成功；
2. 如果失败，指出关键错误；
3. 给出下一步建议；
4. 如需继续运行命令，只提出建议，不要假装已经执行。

HEADER

  echo "## Original user question"
  echo '```text'
  cat "$USER_INPUT"
  echo '```'

  echo
  echo "## Executed commands"
  echo '```bash'
  cat "$RUN_DIR/commands.sh"
  echo '```'

  echo
  echo "## Execution meta"
  echo '```text'
  cat "$RUN_DIR/meta.txt"
  echo '```'

  echo
  echo "## Execution output"
  echo '```text'
  tail -500 "$RUN_DIR/output.log"
  echo '```'
} > "$FOLLOW_PROMPT"

ui_spinner_start "Waiting for follow-up analysis..."

FOLLOW_RESPONSE="$TMP_DIR/followup_response.txt"
if ! copilot-cmd-send --prompt-file "$FOLLOW_PROMPT" -- \
  "${COPILOT_EXTRA_ARGS[@]}" \
  --deny-tool='shell(*)' \
  --deny-tool='write' > "$FOLLOW_RESPONSE" 2>&1; then
  copilot-cmd-send --prompt-file "$FOLLOW_PROMPT" -- \
    "${COPILOT_EXTRA_ARGS[@]}" \
    --deny-tool='shell' \
    --deny-tool='write' > "$FOLLOW_RESPONSE" 2>&1
fi

ui_spinner_stop

_UI_CURRENT_SECTION="follow-up analysis"
ui_section "follow-up analysis"
cat "$FOLLOW_RESPONSE"
ui_section_end

exit "$RC"
