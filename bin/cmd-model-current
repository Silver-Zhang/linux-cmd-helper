#!/usr/bin/env bash
set -euo pipefail

CURRENT_FILE="$HOME/.config/copilot-cmd/current-native-model"
ENV_LIB="$HOME/.local/lib/copilot-cmd-env.sh"

# DeepSeek 模型名以 lib/copilot-cmd-env.sh 为准，本脚本不再重复写死。
# 该库在缺少 DeepSeek key 时会 exit 1，而本命令只做只读展示、不应依赖 key，
# 因此先在子 shell 里探测一次，确认能安全加载后才真正 source。
if [ -f "$ENV_LIB" ] && ( source "$ENV_LIB" ) >/dev/null 2>&1; then
  # shellcheck disable=SC1090
  source "$ENV_LIB"
fi

if [ -f "$CURRENT_FILE" ]; then
  echo "GitHub Copilot native 显示模型: $(cat "$CURRENT_FILE")"
else
  echo "GitHub Copilot native 显示模型: 未设置"
fi

echo "DeepSeek 默认模型: ${CMD_DEEPSEEK_FLASH_MODEL:-deepseek-flash}"
echo "DeepSeek Pro 模型: ${CMD_DEEPSEEK_PRO_MODEL:-deepseek-v4-pro}"
