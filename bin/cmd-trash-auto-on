#!/usr/bin/env bash
set -euo pipefail

DAYS="${1:-30}"

if ! [[ "$DAYS" =~ ^[0-9]+$ ]]; then
  echo "用法：cmd-trash-auto-on [天数]" >&2
  exit 1
fi

if ! command -v crontab >/dev/null 2>&1; then
  echo "未找到 crontab，本系统上无法使用定时清理回收站功能。" >&2
  echo "你仍可手动清理：cmd-trash-prune [天数] [sessions|cache|all]" >&2
  exit 1
fi

CMD="$HOME/.local/bin/cmd-trash-prune $DAYS all >/dev/null 2>&1"
MARK_BEGIN="# BEGIN COPILOT-CMD-TRASH-AUTO"
MARK_END="# END COPILOT-CMD-TRASH-AUTO"

TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

crontab -l 2>/dev/null | sed "/$MARK_BEGIN/,/$MARK_END/d" > "$TMP" || true

{
  cat "$TMP"
  echo "$MARK_BEGIN"
  echo "30 3 * * * $CMD"
  echo "$MARK_END"
} | crontab -

echo "已开启回收站定时清理："
echo "  保留天数: $DAYS"
echo "  计划: 每天 03:30"
